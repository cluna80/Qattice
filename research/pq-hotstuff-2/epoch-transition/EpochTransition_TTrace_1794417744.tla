---- MODULE EpochTransition_TTrace_1794417744 ----
EXTENDS Sequences, TLCExt, Toolbox, Naturals, TLC, EpochTransition

_expression ==
    LET EpochTransition_TEExpression == INSTANCE EpochTransition_TEExpression
    IN EpochTransition_TEExpression!expression
----

_trace ==
    LET EpochTransition_TETrace == INSTANCE EpochTransition_TETrace
    IN EpochTransition_TETrace!trace
----

