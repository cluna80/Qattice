<<1, <<0>>, "EC", "A", 1, <<>>>>, "S", "-", 0, <<"S0", 0, 2, 1, <<1, <<0>>, "EC", "A", 1, <<>>>>>>>>>>, <<"B", <<3, <<2, <<1, <<0>>, "EC", "A", 1, <<>>>>, "S", "-", 2, <<>>>>, "N", "-", 3, <<>>>>>>}))
